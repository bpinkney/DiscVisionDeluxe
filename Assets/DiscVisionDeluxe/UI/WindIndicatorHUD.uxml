<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="WindIndicatorHUD.uss" />

    <!-- Root anchored to a corner of the screen via USS absolute positioning.
         The 3D windsock GameObject lives above this in world space; these labels
         sit below it as a 2D overlay. -->
    <ui:VisualElement name="wind-hud-root" class="wind-hud-root">
        <ui:Label name="wind-cardinal" text="N"     class="wind-cardinal" />
        <ui:Label name="wind-speed"    text="0 kph" class="wind-speed"    />
    </ui:VisualElement>

</ui:UXML>
